<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    
    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- Google Font (Inter) -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f8f9fa;
        }
    </style>
    
    <HeadOutlet />
</head>

<body>
    <Routes />

    <!-- Script de reconexión de Blazor -->
    <div id="blazor-error-ui" class="alert alert-warning alert-dismissible fade show position-fixed bottom-0 start-0 m-3 shadow" style="display: none; z-index: 9999;" role="alert">
        An unhandled error has occurred. <a href="" class="reload alert-link">Reload</a>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>

    <!-- Scripts de Blazor y Bootstrap -->
    <script src="_framework/blazor.web.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <!-- JS Interop para Modales de Bootstrap -->
    <script>
        window.bootstrapModal = {
            show: function (modalId) {
                var el = document.getElementById(modalId);
                if (el) {
                    var modal = bootstrap.Modal.getOrCreateInstance(el);
                    modal.show();
                }
            },
            hide: function (modalId) {
                var el = document.getElementById(modalId);
                if (el) {
                    var modal = bootstrap.Modal.getInstance(el);
                    if (modal) {
                        modal.hide();
                    }
                }
            }
        };
    </script>
</body>

</html>