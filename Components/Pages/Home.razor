@page "/"

<PageTitle>Inicio - WebEmpresa</PageTitle>

<div class="container-fluid px-4 py-4">
    <!-- Banner de Bienvenida -->
    <div class="card border-0 bg-primary text-white rounded-4 p-4 mb-4 shadow-sm position-relative overflow-hidden">
        <div class="row align-items-center position-relative z-1">
            <div class="col-lg-8">
                <h1 class="fw-bold mb-2">¡Bienvenido a WebEmpresa!</h1>
                <p class="lead opacity-75 mb-3">
                    Sistema integral de gestión empresarial conectado en tiempo real con <strong>ApiEmpresaV2</strong>.
                </p>
                <a href="/clientes" class="btn btn-light text-primary fw-semibold px-4 py-2 rounded-3 shadow-sm">
                    <i class="bi bi-people-fill me-2"></i>Ir a Gestión de Clientes
                </a>
            </div>
        </div>
    </div>

    <!-- Indicadores / Resumen de Módulos -->
    <div class="row g-4 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100 p-3 bg-white">
                <div class="card-body d-flex align-items-center">
                    <div class="rounded-3 bg-primary bg-opacity-10 text-primary p-3 me-3">
                        <i class="bi bi-people fs-2"></i>
                    </div>
                    <div>
                        <h6 class="text-muted mb-1 fw-semibold">Módulo Clientes</h6>
                        <h5 class="fw-bold mb-0 text-dark">Administración CRUD</h5>
                        <p class="text-muted small mb-0 mt-1">Alta, edición, búsqueda y eliminación.</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100 p-3 bg-white">
                <div class="card-body d-flex align-items-center">
                    <div class="rounded-3 bg-success bg-opacity-10 text-success p-3 me-3">
                        <i class="bi bi-cloud-check fs-2"></i>
                    </div>
                    <div>
                        <h6 class="text-muted mb-1 fw-semibold">Backend API</h6>
                        <h5 class="fw-bold mb-0 text-dark">ApiEmpresaV2</h5>
                        <p class="text-muted small mb-0 mt-1">Conexión activa REST HTTP/JSON.</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100 p-3 bg-white">
                <div class="card-body d-flex align-items-center">
                    <div class="rounded-3 bg-info bg-opacity-10 text-info p-3 me-3">
                        <i class="bi bi-speedometer2 fs-2"></i>
                    </div>
                    <div>
                        <h6 class="text-muted mb-1 fw-semibold">Tecnología</h6>
                        <h5 class="fw-bold mb-0 text-dark">Blazor Interactive</h5>
                        <p class="text-muted small mb-0 mt-1">Interfaz rápida y dinámica.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Accesos Rápidos / Guía del Sistema -->
    <div class="card border-0 shadow-sm rounded-4 bg-white p-4">
        <h5 class="fw-bold text-dark mb-3">
            <i class="bi bi-rocket-takeoff-fill text-primary me-2"></i>Acceso Rápido
        </h5>
        <div class="row g-3">
            <div class="col-md-6">
                <div class="p-3 border rounded-3 bg-light d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="fw-bold mb-1 text-dark">Gestión de Clientes</h6>
                        <p class="text-muted small mb-0">Consulta y administra la base de datos de clientes.</p>
                    </div>
                    <a href="/clientes" class="btn btn-outline-primary btn-sm rounded-3 fw-semibold">
                        Abrir
                    </a>
                </div>
            </div>
            <div class="col-md-6">
                <div class="p-3 border rounded-3 bg-light d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="fw-bold mb-1 text-dark">Documentación Swagger</h6>
                        <p class="text-muted small mb-0">Revisa las rutas de la API en el servidor local.</p>
                    </div>
                    <a href="https://localhost:7231/swagger" target="_blank" class="btn btn-outline-secondary btn-sm rounded-3 fw-semibold">
                        Swagger API
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>